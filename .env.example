# Local development: Postgres in Docker (pnpm db:up), see docker-compose.yml.
DATABASE_URL="postgresql://sava:sava@localhost:5432/sava_dev"
DIRECT_URL="postgresql://sava:sava@localhost:5432/sava_dev"
# pnpm test uses its own database (created by docker/postgres/init). Unset → DIRECT_URL's `test` schema.
TEST_DATABASE_URL="postgresql://sava:sava@localhost:5432/sava_test"
# Hosted (Vercel): set DATABASE_URL (pooled) and DIRECT_URL (direct) to the production database instead.
AUTH_SECRET="generate-a-random-32-byte-secret"
APP_URL="http://localhost:3000"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
ENCRYPTION_KEY="generate-a-random-32-byte-base64-key"

NEON_CONNECTION_STRING=""
# OpenRouter key for the claude-or implementer workflow — see docs/model-routing.md
APIKEY-SavaTM="sk-or-v1-..."
